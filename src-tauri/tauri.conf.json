{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Python Mission Control",
  "version": "0.1.0",
  "identifier": "local.python-mission-control.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Python Mission Control",
      "width": 1440,
      "height": 960,
      "minWidth": 900,
      "minHeight": 650,
      "backgroundColor": "#101714"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "resources/mission-python/": "mission-python/" },
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    },
    "shortDescription": "Predict, trace and master Python fundamentals",
    "category": "Education"
  }
}
