{
  "name": "python-mission-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "tauri dev",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:python": "python -m unittest discover -s python -p test_*.py -v",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "bundle:python": "node scripts/bundle-python.mjs",
    "build:windows": "npm run bundle:python && tauri build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
